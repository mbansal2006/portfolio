import React, { useState, useEffect, useRef, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';
import { useExploration } from '@/contexts/ExplorationContext';
import { Button } from '@/components/ui/button';
import { ArrowLeft, Brain, Play, Pause, RotateCcw, Calculator, TrendingUp, Lightbulb } from 'lucide-react';

interface Node {
  id: string;
  x: number;
  y: number;
  value: number;
  bias: number;
  layer: number;
  activation: 'sigmoid' | 'relu';
}

interface Connection {
  id: string;
  from: string;
  to: string;
  weight: number;
}

interface TrainingExample {
  numerator: number;
  denominator: number;
  result: number;
}

const InfinityRoom: React.FC = () => {
  const navigate = useNavigate();
  const { isInfinityRoomUnlocked } = useExploration();
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [showUnlockMessage, setShowUnlockMessage] = useState(false);
  const [canvasSize, setCanvasSize] = useState({ width: 0, height: 0 });
  
  // Simple neural network state
  const [nodes, setNodes] = useState<Node[]>([]);
  const [connections, setConnections] = useState<Connection[]>([]);
  const [isTraining, setIsTraining] = useState(false);
  const [currentEpoch, setCurrentEpoch] = useState(0);
  const [loss, setLoss] = useState(0);
  const [accuracy, setAccuracy] = useState(0);
  const [learningRate, setLearningRate] = useState(0.01);
  
  // User interaction
  const [userNumerator, setUserNumerator] = useState(8);
  const [userDenominator, setUserDenominator] = useState(2);
  const [networkPrediction, setNetworkPrediction] = useState(0);
  const [actualResult, setActualResult] = useState(4);
  const [showExplanation, setShowExplanation] = useState(false);
  const [trainingExamples, setTrainingExamples] = useState<TrainingExample[]>([]);

  // Check if user has unlocked the room
  useEffect(() => {
    if (!isInfinityRoomUnlocked) {
      setShowUnlockMessage(true);
      const timer = setTimeout(() => {
        navigate('/');
      }, 3000);
      return () => clearTimeout(timer);
    }
  }, [isInfinityRoomUnlocked, navigate]);

  // Canvas setup
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const resizeCanvas = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
      setCanvasSize({ width, height });
    };

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    return () => window.removeEventListener('resize', resizeCanvas);
  }, []);

  // Initialize simple network (2 inputs -> 1 hidden -> 1 output)
  useEffect(() => {
    if (canvasSize.width === 0) return;
    
    const centerX = canvasSize.width / 2;
    const centerY = canvasSize.height / 2;
    
    const inputNodes: Node[] = [
      { id: 'numerator', x: centerX - 200, y: centerY - 50, value: 0, bias: 0, layer: 0, activation: 'sigmoid' },
      { id: 'denominator', x: centerX - 200, y: centerY + 50, value: 0, bias: 0, layer: 0, activation: 'sigmoid' },
    ];
    
    const hiddenNodes: Node[] = [
      { id: 'hidden', x: centerX, y: centerY, value: 0, bias: 0, layer: 1, activation: 'relu' },
    ];
    
    const outputNodes: Node[] = [
      { id: 'result', x: centerX + 200, y: centerY, value: 0, bias: 0, layer: 2, activation: 'sigmoid' },
    ];
    
    const defaultConnections: Connection[] = [
      { id: 'c1', from: 'numerator', to: 'hidden', weight: Math.random() * 2 - 1 },
      { id: 'c2', from: 'denominator', to: 'hidden', weight: Math.random() * 2 - 1 },
      { id: 'c3', from: 'hidden', to: 'result', weight: Math.random() * 2 - 1 },
    ];
    
    setNodes([...inputNodes, ...hiddenNodes, ...outputNodes]);
    setConnections(defaultConnections);
    
    // Generate simple division training data
    const examples: TrainingExample[] = [
      { numerator: 4, denominator: 2, result: 2 },
      { numerator: 6, denominator: 3, result: 2 },
      { numerator: 8, denominator: 2, result: 4 },
      { numerator: 10, denominator: 5, result: 2 },
      { numerator: 12, denominator: 3, result: 4 },
      { numerator: 15, denominator: 3, result: 5 },
      { numerator: 16, denominator: 4, result: 4 },
      { numerator: 20, denominator: 5, result: 4 },
    ];
    setTrainingExamples(examples);
  }, [canvasSize.width, canvasSize.height]);

  // Activation functions
  const sigmoid = (x: number): number => 1 / (1 + Math.exp(-x));
  const relu = (x: number): number => Math.max(0, x);
  
  const activate = (x: number, activation: string): number => {
    switch (activation) {
      case 'sigmoid': return sigmoid(x);
      case 'relu': return relu(x);
      default: return sigmoid(x);
    }
  };

  // Forward pass
  const forwardPass = useCallback((numerator: number, denominator: number): number => {
    const nodeValues = new Map<string, number>();
    
    // Set input values (normalize to 0-1 range)
    nodeValues.set('numerator', numerator / 20); // Assume max input is 20
    nodeValues.set('denominator', denominator / 10); // Assume max input is 10
    
    // Process hidden layer
    const hiddenNode = nodes.find(n => n.id === 'hidden');
    if (hiddenNode) {
      let sum = hiddenNode.bias;
      connections
        .filter(c => c.to === 'hidden')
        .forEach(conn => {
          const fromValue = nodeValues.get(conn.from) || 0;
          sum += fromValue * conn.weight;
        });
      nodeValues.set('hidden', activate(sum, hiddenNode.activation));
    }
    
    // Process output layer
    const resultNode = nodes.find(n => n.id === 'result');
    if (resultNode) {
      let sum = resultNode.bias;
      connections
        .filter(c => c.to === 'result')
        .forEach(conn => {
          const fromValue = nodeValues.get(conn.from) || 0;
          sum += fromValue * conn.weight;
        });
      const output = activate(sum, resultNode.activation);
      // Denormalize output (scale back to reasonable division results)
      return output * 10;
    }
    
    return 0;
  }, [nodes, connections]);

  // Calculate loss
  const calculateLoss = useCallback((predicted: number, expected: number): number => {
    return Math.pow(predicted - expected, 2);
  }, []);

  // Training step
  const trainStep = useCallback(() => {
    if (!isTraining) return;
    
    let totalLoss = 0;
    let correct = 0;
    
    trainingExamples.forEach(example => {
      const predicted = forwardPass(example.numerator, example.denominator);
      const loss = calculateLoss(predicted, example.result);
      totalLoss += loss;
      
      // Calculate accuracy (within 0.5 of correct answer)
      if (Math.abs(predicted - example.result) < 0.5) correct++;
    });
    
    const avgLoss = totalLoss / trainingExamples.length;
    const acc = correct / trainingExamples.length;
    
    setLoss(avgLoss);
    setAccuracy(acc);
    
    // Simple gradient descent (simplified for visualization)
    setConnections(prev => prev.map(conn => ({
      ...conn,
      weight: conn.weight + (Math.random() - 0.5) * learningRate * 0.1
    })));
    
    setCurrentEpoch(prev => prev + 1);
  }, [isTraining, trainingExamples, forwardPass, calculateLoss, learningRate]);

  // Training loop
  useEffect(() => {
    if (!isTraining) return;
    
    const interval = setInterval(trainStep, 200);
    return () => clearInterval(interval);
  }, [isTraining, trainStep]);

  // Test user input
  const testUserInput = useCallback(() => {
    const result = userNumerator / userDenominator;
    setActualResult(result);
    
    const prediction = forwardPass(userNumerator, userDenominator);
    setNetworkPrediction(prediction);
  }, [userNumerator, userDenominator, forwardPass]);

  // Auto-test when inputs change
  useEffect(() => {
    testUserInput();
  }, [userNumerator, userDenominator, testUserInput]);

  // Render network
  const renderNetwork = useCallback(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    // Clear canvas
    ctx.fillStyle = 'black';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Draw connections
    connections.forEach(conn => {
      const fromNode = nodes.find(n => n.id === conn.from);
      const toNode = nodes.find(n => n.id === conn.to);
      
      if (!fromNode || !toNode) return;
      
      const weight = Math.abs(conn.weight);
      const alpha = Math.min(weight * 0.5 + 0.1, 1);
      const color = conn.weight > 0 ? `rgba(0, 255, 0, ${alpha})` : `rgba(255, 0, 0, ${alpha})`;
      
      ctx.strokeStyle = color;
      ctx.lineWidth = weight * 3 + 1;
      ctx.beginPath();
      ctx.moveTo(fromNode.x, fromNode.y);
      ctx.lineTo(toNode.x, toNode.y);
      ctx.stroke();
    });
    
    // Draw nodes
    nodes.forEach(node => {
      const isInput = node.layer === 0;
      const isOutput = node.layer === 2;
      
      // Node background
      ctx.fillStyle = isInput ? '#3b82f6' : isOutput ? '#ef4444' : '#8b5cf6';
      ctx.beginPath();
      ctx.arc(node.x, node.y, 25, 0, Math.PI * 2);
      ctx.fill();
      
      // Node border
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      
      // Node label
      ctx.fillStyle = 'white';
      ctx.font = 'bold 14px monospace';
      ctx.textAlign = 'center';
      
      if (node.id === 'numerator') {
        ctx.fillText('÷', node.x, node.y + 5);
      } else if (node.id === 'denominator') {
        ctx.fillText('÷', node.x, node.y + 5);
      } else if (node.id === 'hidden') {
        ctx.fillText('?', node.x, node.y + 5);
      } else if (node.id === 'result') {
        ctx.fillText('=', node.x, node.y + 5);
      }
      
      // Node description
      ctx.fillStyle = '#9ca3af';
      ctx.font = '12px monospace';
      if (node.id === 'numerator') {
        ctx.fillText('Top', node.x, node.y + 45);
      } else if (node.id === 'denominator') {
        ctx.fillText('Bottom', node.x, node.y + 45);
      } else if (node.id === 'hidden') {
        ctx.fillText('Learning', node.x, node.y + 45);
      } else if (node.id === 'result') {
        ctx.fillText('Answer', node.x, node.y + 45);
      }
    });
  }, [nodes, connections]);

  // Render loop
  useEffect(() => {
    renderNetwork();
  }, [renderNetwork]);

  // Start/stop training
  const toggleTraining = () => {
    setIsTraining(!isTraining);
  };

  // Reset network
  const resetNetwork = () => {
    setConnections(prev => prev.map(conn => ({
      ...conn,
      weight: Math.random() * 2 - 1
    })));
    setCurrentEpoch(0);
    setLoss(0);
    setAccuracy(0);
    setIsTraining(false);
  };

  // Unlock message
  if (showUnlockMessage) {
    return (
      <div className="fixed inset-0 bg-black flex items-center justify-center z-50">
        <div className="text-center text-yellow-400 font-mono">
          <h1 className="text-4xl mb-4">🔒 Access Denied</h1>
          <p className="text-xl mb-4">You need to explore 100% of the site first!</p>
          <p className="text-lg">Redirecting to home...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="fixed inset-0 bg-black overflow-hidden">
      {/* Header */}
      <div className="absolute top-4 left-4 z-20 flex gap-2">
        <Button
          onClick={() => navigate('/')}
          variant="outline"
          size="sm"
          className="bg-black/50 border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black"
        >
          <ArrowLeft className="w-4 h-4 mr-2" />
          Exit
        </Button>
        <Button
          onClick={toggleTraining}
          variant="outline"
          size="sm"
          className={`${
            isTraining 
              ? 'bg-red-600 text-white border-red-400' 
              : 'bg-green-600 text-white border-green-400'
          } hover:opacity-80`}
        >
          {isTraining ? <Pause className="w-4 h-4 mr-2" /> : <Play className="w-4 h-4 mr-2" />}
          {isTraining ? 'Stop Learning' : 'Start Learning'}
        </Button>
        <Button
          onClick={resetNetwork}
          variant="outline"
          size="sm"
          className="bg-black/50 border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black"
        >
          <RotateCcw className="w-4 h-4 mr-2" />
          Reset Brain
        </Button>
        <Button
          onClick={() => setShowExplanation(!showExplanation)}
          variant="outline"
          size="sm"
          className="bg-black/50 border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black"
        >
          <Lightbulb className="w-4 h-4 mr-2" />
          How It Works
        </Button>
      </div>

      {/* Title */}
      <div className="absolute top-4 left-1/2 transform -translate-x-1/2 z-20 text-center">
        <div className="bg-black/50 border border-yellow-400/50 rounded-lg p-3 text-yellow-400 font-mono">
          <h2 className="text-lg font-bold mb-1 flex items-center justify-center gap-2">
            <Brain className="w-5 h-5" />
            AI Learning Division
          </h2>
          <p className="text-sm">Watch the AI brain learn to divide numbers!</p>
        </div>
      </div>

      {/* How It Works Panel */}
      {showExplanation && (
        <div className="absolute top-16 left-4 z-20 bg-black/80 border border-yellow-400/50 rounded-lg p-4 text-yellow-400 font-mono text-sm space-y-3 max-w-[300px]">
          <h3 className="font-bold text-base">How It Works</h3>
          <div className="space-y-2 text-xs">
            <p>• The AI brain starts with random connections</p>
            <p>• It learns by trying to solve division problems</p>
            <p>• Green lines = positive connections</p>
            <p>• Red lines = negative connections</p>
            <p>• Thicker lines = stronger connections</p>
            <p>• Watch it get better over time!</p>
          </div>
        </div>
      )}

      {/* User Input Panel */}
      <div className="absolute top-16 right-4 z-20 bg-black/80 border border-yellow-400/50 rounded-lg p-4 text-yellow-400 font-mono text-sm space-y-3 min-w-[250px]">
        <h3 className="font-bold text-base flex items-center gap-2">
          <Calculator className="w-4 h-4" />
          Try Your Own Division
        </h3>
        
        <div className="space-y-3">
          <div className="flex items-center gap-2">
            <span>Top number:</span>
            <input
              type="number"
              min="1"
              max="20"
              value={userNumerator}
              onChange={(e) => setUserNumerator(parseInt(e.target.value) || 1)}
              className="w-16 bg-black border border-yellow-400 text-yellow-400 px-2 py-1 rounded text-xs"
            />
          </div>
          <div className="flex items-center gap-2">
            <span>Bottom number:</span>
            <input
              type="number"
              min="1"
              max="10"
              value={userDenominator}
              onChange={(e) => setUserDenominator(parseInt(e.target.value) || 1)}
              className="w-16 bg-black border border-yellow-400 text-yellow-400 px-2 py-1 rounded text-xs"
            />
          </div>
          
          <div className="bg-yellow-900/50 border border-yellow-400/30 rounded p-2 space-y-1">
            <div className="text-xs text-yellow-300">
              {userNumerator} ÷ {userDenominator} = ?
            </div>
            <div className="flex justify-between text-xs">
              <span>AI thinks:</span>
              <span className={Math.abs(networkPrediction - actualResult) < 0.5 ? 'text-green-400' : 'text-red-400'}>
                {networkPrediction.toFixed(2)}
              </span>
            </div>
            <div className="flex justify-between text-xs">
              <span>Real answer:</span>
              <span className="text-blue-400">{actualResult.toFixed(2)}</span>
            </div>
          </div>
        </div>
      </div>

      {/* Canvas */}
      <canvas
        ref={canvasRef}
        className="cursor-default"
      />

      {/* Training Stats */}
      <div className="absolute bottom-4 right-4 z-20 bg-black/80 border border-yellow-400/50 rounded-lg p-4 text-yellow-400 font-mono text-sm space-y-2 min-w-[200px]">
        <h3 className="font-bold text-base flex items-center gap-2">
          <TrendingUp className="w-4 h-4" />
          Learning Progress
        </h3>
        <div className="space-y-1">
          <div className="flex justify-between">
            <span>Practice rounds:</span>
            <span>{currentEpoch}</span>
          </div>
          <div className="flex justify-between">
            <span>Mistakes:</span>
            <span>{loss.toFixed(2)}</span>
          </div>
          <div className="flex justify-between">
            <span>Getting better:</span>
            <span>{(accuracy * 100).toFixed(0)}%</span>
          </div>
          <div className="flex justify-between">
            <span>Status:</span>
            <span className={isTraining ? 'text-green-400' : 'text-gray-400'}>
              {isTraining ? 'Learning!' : 'Waiting'}
            </span>
          </div>
        </div>
      </div>

      {/* Instructions */}
      <div className="absolute bottom-4 left-4 z-20 bg-black/80 border border-yellow-400/50 rounded-lg p-4 text-yellow-400 font-mono text-sm max-w-[300px]">
        <h3 className="font-bold mb-2">What's Happening</h3>
        <div className="space-y-1 text-xs">
          <div>• The AI brain is learning to divide numbers</div>
          <div>• It starts with random guesses</div>
          <div>• Each practice round makes it smarter</div>
          <div>• Try your own numbers to test it!</div>
          <div>• Watch the connections get stronger</div>
        </div>
      </div>
    </div>
  );
};

export default InfinityRoom;
